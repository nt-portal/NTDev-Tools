{
  "manifest_version": 2,
  "name": "NT DevTools",
  "version": "1.1.0",
  "description": "Konsol pengembang web khusus untuk debugging dan inspeksi seluler (mobile web debugging).",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_action": {
    "default_title": "NT DevTools",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "webNavigation",
    "webRequest",
    "<all_urls>"
  ],
  "web_accessible_resources": ["icons/icon.png", "injected.js"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["bootstrap.js"], "run_at": "document_start", "all_frames": false },
    { "matches": ["<all_urls>"], "js": ["injected.js"], "run_at": "document_start", "world": "MAIN", "all_frames": false }
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ntdevtools@ntdev.org",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
